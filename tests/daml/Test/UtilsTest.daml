-- | Tests for the typed `Values` accessors in `DataStandard.Utils`.
module Test.UtilsTest where

import DA.Assert ((===))
import DA.Date (Month(Nov), date)
import DA.TextMap (TextMap)
import qualified DA.TextMap as TM
import Daml.Script

import DataStandard.Utils

testTypedFieldRoundTrips : Script ()
testTypedFieldRoundTrips = do
  now <- getTime
  let vs = insertField "i"  (42 : Int)
         $ insertField "d"  (1.0432 : Decimal)
         $ insertField "t"  ("eurc-usd" : Text)
         $ insertField "ts" now
         $ insertField "b"  True
           TM.empty
  lookupField "i"  vs === Some (42 : Int)
  lookupField "d"  vs === Some (1.0432 : Decimal)
  lookupField "t"  vs === Some ("eurc-usd" : Text)
  lookupField "ts" vs === Some now
  lookupField "b"  vs === Some True

testMissingFieldIsNone : Script ()
testMissingFieldIsNone = do
  let vs = insertField "present" (1 : Int) TM.empty
  (lookupField "absent" vs : Optional Int) === None

testWrongTypeIsNone : Script ()
testWrongTypeIsNone = do
  let vs = insertField "rate" (1.0432 : Decimal) TM.empty
  (lookupField "rate" vs : Optional Text) === None

testListRoundTrips : Script ()
testListRoundTrips = do
  let vs = insertField "xs" ([1, 2, 3] : [Int]) TM.empty
  (lookupField "xs" vs : Optional [Int]) === Some [1, 2, 3]

testMapRoundTrips : Script ()
testMapRoundTrips = do
  let weights = TM.fromList [("eurc", 0.6), ("usdc", 0.4)] : TextMap Decimal
  let vs = insertField "weights" weights TM.empty
  (lookupField "weights" vs : Optional (TextMap Decimal)) === Some weights

testNestedConstituentsRoundTrip : Script ()
testNestedConstituentsRoundTrip = do
  let mkConstituent symbol weight =
        insertField "symbol" (symbol : Text)
          $ insertField "weight" (weight : Decimal) TM.empty
      constituents =
        [ mkConstituent "eurc-usd" 0.6
        , mkConstituent "usdc-usd" 0.4
        ] : [TextMap AnyValue]
  let vs = insertField "constituents" constituents TM.empty
  (lookupField "constituents" vs : Optional [TextMap AnyValue]) === Some constituents

testListReadAsScalarIsNone : Script ()
testListReadAsScalarIsNone = do
  let vs = insertField "xs" ([1, 2, 3] : [Int]) TM.empty
  (lookupField "xs" vs : Optional Int) === None

testPartyAndInstrumentIdRoundTrip : Script ()
testPartyAndInstrumentIdRoundTrip = do
  registry <- allocateParty "Registry"
  let usdcx = InstrumentId with admin = registry, id = "USDCx"
  let vs = insertField "registry" registry
         $ insertField "instrument" usdcx TM.empty
  lookupField "registry" vs === Some registry
  lookupField "instrument" vs === Some usdcx
  (lookupField "instruments" (insertField "instruments" [usdcx] TM.empty) : Optional [InstrumentId])
    === Some [usdcx]

testPartyAndInstrumentIdWrongTypeIsNone : Script ()
testPartyAndInstrumentIdWrongTypeIsNone = do
  registry <- allocateParty "Registry"
  let usdcx = InstrumentId with admin = registry, id = "USDCx"
  let vs = insertField "registry" registry
         $ insertField "instrument" usdcx
         $ insertField "registryText" (partyToText registry) TM.empty
  (lookupField "registry" vs : Optional Text) === None
  (lookupField "instrument" vs : Optional Party) === None
  (lookupField "registryText" vs : Optional Party) === None

testDateRoundTrip : Script ()
testDateRoundTrip = do
  let maturity = date 2035 Nov 15
  let vs = insertField "maturityDate" maturity TM.empty
  lookupField "maturityDate" vs === Some maturity
  (lookupField "dates" (insertField "dates" [maturity] TM.empty) : Optional [Date])
    === Some [maturity]

-- | A date and a time are distinct tags: a date is never read as a time at
-- midnight, nor a time truncated to its date.
testDateAndTimeAreNotInterchangeable : Script ()
testDateAndTimeAreNotInterchangeable = do
  now <- getTime
  let vs = insertField "maturityDate" (date 2035 Nov 15)
         $ insertField "ts" now TM.empty
  (lookupField "maturityDate" vs : Optional Time) === None
  (lookupField "ts" vs : Optional Date) === None
  (lookupField "ts" vs : Optional Time) === Some now

-- | An `Optional` field round-trips: `Some` as the bare value, `None` as
-- `AVNull`. `Optional Int` therefore holds exactly `AVInt` or `AVNull`.
testOptionalRoundTrip : Script ()
testOptionalRoundTrip = do
  let vs = insertField "bid" (Some 101 : Optional Int)
         $ insertField "ask" (None : Optional Int) TM.empty
  TM.lookup "bid" vs === Some (AVInt 101)
  TM.lookup "ask" vs === Some AVNull
  lookupField "bid" vs === Some (Some 101 : Optional Int)
  lookupField "ask" vs === Some (None : Optional Int)
  let series = [Some 4.51, None, Some 4.53] : [Optional Decimal]
  lookupField "series" (insertField "series" series TM.empty) === Some series

-- | Reading as `Optional` does not widen what a field may hold: a value of
-- another type is still a failed read, and an absent key is still `None` at the
-- outer level rather than an explicit null.
testOptionalIsStrict : Script ()
testOptionalIsStrict = do
  let vs = insertField "rate" (1.0432 : Decimal)
         $ insertField "info" (None : Optional Text) TM.empty
  (lookupField "rate" vs : Optional (Optional Int)) === None
  (lookupField "absent" vs : Optional (Optional Int)) === None
  (lookupField "rate" vs : Optional (Optional Decimal)) === Some (Some 1.0432)

-- | A null read at a type that is not `Optional` is a failed read, never a
-- sentinel such as zero or the empty text.
testNullReadAsScalarIsNone : Script ()
testNullReadAsScalarIsNone = do
  let vs = insertField "info" (None : Optional Text) TM.empty
  (lookupField "info" vs : Optional Text) === None
  (lookupField "info" vs : Optional Int) === None
  (lookupField "info" vs : Optional [Int]) === None
  (lookupField "info" vs : Optional AnyValue) === Some AVNull
