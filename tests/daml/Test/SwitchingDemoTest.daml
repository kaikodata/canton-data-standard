-- | The distributor-switching demonstration: one consumer reads the same feed
-- from two structurally different distributors with no Daml change. The direct
-- distributor stores a price; the market-maker distributor stores a bid and an ask
-- and derives the mid. Both publish the same `assetPair`/`price` keys through the
-- one interface, so the same compiled consumer choices settle against either, and
-- switching distributor amounts to passing a different `expectedDistributor`.
module Test.SwitchingDemoTest where

import DA.Assert ((===))
import Daml.Script

import SwitchingConsumer.Trading
import SwitchingDistributorDirect.Oracle
import SwitchingDistributorMarketMaker.Oracle
import DataStandard.DataPointV1 (PublishedDataPoint)
import DataStandard.Utils (emptyMetadata)
import Test.Fixtures
import Test.Templates

-- | Both distributors publish the same feed at the same price (the market maker's
-- bid/ask straddle it), and the one `DataPointSwitchOffer` choice settles against
-- each in turn. All that changes between the two is `expectedDistributor`. The
-- market maker's view carries extra `bid`/`ask` fields, which a consumer reading
-- only `assetPair` and `price` ignores.
testSwitchAcrossDistributors : Script ()
testSwitchAcrossDistributors = do
  oracleDirect <- allocateParty "OracleDirect"
  oracleMM     <- allocateParty "OracleMarketMaker"
  seller       <- allocateParty "Seller"
  buyer        <- allocateParty "Buyer"
  now          <- getTime

  directCid <- submit oracleDirect $ createCmd DirectQuote with
    oracle = oracleDirect, assetPair = "BTC/USD"
    price = 65000.0, publishedAt = now
  mmCid <- submit oracleMM $ createCmd MarketMakerQuote with
    oracle = oracleMM, assetPair = "BTC/USD"
    bid = 64999.0, ask = 65001.0, publishedAt = now

  -- The same consumer choice handles the direct distributor ...
  directOfferCid <- submit seller $ createCmd DataPointSwitchOffer with
    seller, buyer, expectedDistributor = oracleDirect, assetPair = "BTC/USD"
    quantity = 0.5
    dataCid = toInterfaceContractId @PublishedDataPoint directCid
  Some directDisc <- queryDisclosure oracleDirect directCid
  directSettleCid <- submit (actAs buyer <> disclose directDisc) $
    exerciseCmd directOfferCid AcceptDataPointSwitch
  Some directSettle <- queryContractId buyer directSettleCid
  directSettle.price       === 65000.0
  directSettle.distributor === oracleDirect

  -- ... and the market maker, unchanged.
  mmOfferCid <- submit seller $ createCmd DataPointSwitchOffer with
    seller, buyer, expectedDistributor = oracleMM, assetPair = "BTC/USD"
    quantity = 0.5
    dataCid = toInterfaceContractId @PublishedDataPoint mmCid
  Some mmDisc <- queryDisclosure oracleMM mmCid
  mmSettleCid <- submit (actAs buyer <> disclose mmDisc) $
    exerciseCmd mmOfferCid AcceptDataPointSwitch
  Some mmSettle <- queryContractId buyer mmSettleCid
  mmSettle.price       === 65000.0
  mmSettle.distributor === oracleMM

-- | An offer that trusts `oracleDirect` but is handed the market maker's
-- publication aborts. The standard authenticates the distributor; the consumer
-- gates on the one it trusts.
testRejectsUntrustedDistributor : Script ()
testRejectsUntrustedDistributor = do
  oracleDirect <- allocateParty "OracleDirect"
  oracleMM     <- allocateParty "OracleMarketMaker"
  seller       <- allocateParty "Seller"
  buyer        <- allocateParty "Buyer"
  now          <- getTime

  mmCid <- submit oracleMM $ createCmd MarketMakerQuote with
    oracle = oracleMM, assetPair = "BTC/USD"
    bid = 64999.0, ask = 65001.0, publishedAt = now
  offerCid <- submit seller $ createCmd DataPointSwitchOffer with
    seller, buyer, expectedDistributor = oracleDirect, assetPair = "BTC/USD"
    quantity = 0.5
    dataCid = toInterfaceContractId @PublishedDataPoint mmCid
  Some disc <- queryDisclosure oracleMM mmCid
  submitFailsWith buyer disc (exerciseCmd offerCid AcceptDataPointSwitch)
    "untrusted distributor"

-- | A trusted distributor publishing a schema without an `assetPair` field
-- aborts on the missing field. `TestFeed` is a valid `PublishedDataPoint`
-- implementation carrying `feedId`/`rate`, not `assetPair`.
testSwitchRejectsForeignSchema : Script ()
testSwitchRejectsForeignSchema = do
  oracle <- allocateParty "OracleDirect"
  seller <- allocateParty "Seller"
  buyer  <- allocateParty "Buyer"
  now    <- getTime

  feedCid <- submit oracle $ createCmd TestFeed with
    oracle, subscriber = oracle, feedId = "eurc-usd", rate = 1.0432, at = now
    meta = emptyMetadata
  offerCid <- submit seller $ createCmd DataPointSwitchOffer with
    seller, buyer, expectedDistributor = oracle, assetPair = "BTC/USD"
    quantity = 0.5
    dataCid = toInterfaceContractId @PublishedDataPoint feedCid
  Some disc <- queryDisclosure oracle feedCid
  submitFailsWith buyer disc (exerciseCmd offerCid AcceptDataPointSwitch)
    "published data missing field: assetPair"

-- | When two trusted distributors agree within tolerance, the cross-check settles
-- at the average of their prices.
testCrossCheckSettlesWhenDistributorsAgree : Script ()
testCrossCheckSettlesWhenDistributorsAgree = do
  oracleDirect <- allocateParty "OracleDirect"
  oracleMM     <- allocateParty "OracleMarketMaker"
  seller       <- allocateParty "Seller"
  buyer        <- allocateParty "Buyer"
  now          <- getTime

  directCid <- submit oracleDirect $ createCmd DirectQuote with
    oracle = oracleDirect, assetPair = "BTC/USD"
    price = 65000.0, publishedAt = now
  -- Mid of 64998/65006 is 65002, ten dollars above the direct distributor.
  mmCid <- submit oracleMM $ createCmd MarketMakerQuote with
    oracle = oracleMM, assetPair = "BTC/USD"
    bid = 64998.0, ask = 65006.0, publishedAt = now

  offerCid <- submit seller $ createCmd CrossCheckOffer with
    seller, buyer
    expectedDistributorA = oracleDirect, expectedDistributorB = oracleMM
    assetPair = "BTC/USD", quantity = 0.5, tolerance = 50.0
    dataCidA = toInterfaceContractId @PublishedDataPoint directCid
    dataCidB = toInterfaceContractId @PublishedDataPoint mmCid
  Some discA <- queryDisclosure oracleDirect directCid
  Some discB <- queryDisclosure oracleMM mmCid
  settleCid <- submit (actAs buyer <> disclose discA <> disclose discB) $
    exerciseCmd offerCid AcceptCrossCheck
  Some s <- queryContractId buyer settleCid
  s.price          === 65001.0
  s.distributorA   === oracleDirect
  s.distributorB   === oracleMM

-- | When two distributors disagree beyond tolerance, the cross-check aborts
-- instead of settling on a contested price.
testCrossCheckRejectsWhenDistributorsDisagree : Script ()
testCrossCheckRejectsWhenDistributorsDisagree = do
  oracleDirect <- allocateParty "OracleDirect"
  oracleMM     <- allocateParty "OracleMarketMaker"
  seller       <- allocateParty "Seller"
  buyer        <- allocateParty "Buyer"
  now          <- getTime

  directCid <- submit oracleDirect $ createCmd DirectQuote with
    oracle = oracleDirect, assetPair = "BTC/USD"
    price = 65000.0, publishedAt = now
  -- Mid of 69999/70001 is 70000, five thousand above the direct distributor.
  mmCid <- submit oracleMM $ createCmd MarketMakerQuote with
    oracle = oracleMM, assetPair = "BTC/USD"
    bid = 69999.0, ask = 70001.0, publishedAt = now

  offerCid <- submit seller $ createCmd CrossCheckOffer with
    seller, buyer
    expectedDistributorA = oracleDirect, expectedDistributorB = oracleMM
    assetPair = "BTC/USD", quantity = 0.5, tolerance = 50.0
    dataCidA = toInterfaceContractId @PublishedDataPoint directCid
    dataCidB = toInterfaceContractId @PublishedDataPoint mmCid
  Some discA <- queryDisclosure oracleDirect directCid
  Some discB <- queryDisclosure oracleMM mmCid
  expectAbort
    (trySubmit (actAs buyer <> disclose discA <> disclose discB)
       (exerciseCmd offerCid AcceptCrossCheck))
    "distributors disagree beyond tolerance"
