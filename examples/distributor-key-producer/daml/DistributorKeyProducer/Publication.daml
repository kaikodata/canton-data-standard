-- | A reference distributor for the pull path. Its entire on-ledger obligation
-- is one contract: hold the public key on a template it signs, implement
-- `DistributorKey` so consumers can read it, and disclose it to them. Signing
-- happens off-ledger and verification happens in the consumer's own choice, so
-- there is no verify choice here.
--
-- The publication is long-lived and contention-free: a read never archives it,
-- and one contract authenticates every payload the key signs.
module DistributorKeyProducer.Publication where

import DataStandard.DistributorKeyV1

-- | A distributor's published signing key. The scheme fields are fixed by the
-- standard and set to their constants in the view; `payloadCodec` is a template
-- field, because which envelope a key signs is the distributor's configuration.
template DistributorKeyPublication
  with
    distributor : Party
      -- ^ The distributor; signs and owns the publication, and is the party
      -- whose signatures this key validates.
    publicKey : Text
      -- ^ The distributor's hex DER-SPKI secp256k1 public key.
    payloadCodec : Text
      -- ^ The envelope this key signs, for example the codecs package's
      -- `dataPointHashCodecId`. Verification refuses a key whose codec is not
      -- the one it implements, so this field binds a key to a payload shape.
  where
    signatory distributor

    interface instance DistributorKey for DistributorKeyPublication where
      view = DistributorKeyView with
        distributor
        publicKey
        signMethod = "secp256k1"
        hashMethod = "SHA-256"
        payloadCodec

    -- | Rotate the signing key by archiving this publication and creating its
    -- replacement. Payloads signed under the old key stop verifying the moment
    -- this contract is archived, because consumers can no longer read it. How a
    -- consumer learns that rotation happened sits outside the standard.
    choice RotateKey : ContractId DistributorKeyPublication
      with
        newPublicKey : Text
      controller distributor
      do create this with publicKey = newPublicKey
