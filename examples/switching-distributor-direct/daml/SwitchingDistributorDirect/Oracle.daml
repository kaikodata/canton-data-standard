-- | A reference distributor for the switching demonstration: the ordinary
-- oracle shape. It stores a price directly and implements both `PublishedQuote`
-- and `PublishedDataPoint` on one template. The structurally different
-- `SwitchingDistributorMarketMaker.Oracle` exposes the identical views from a
-- different internal representation, and a consumer reading through the
-- interfaces cannot tell the two apart.
module SwitchingDistributorDirect.Oracle where

import qualified DA.TextMap as TM

import DataStandard.DataPointV1
import DataStandard.QuoteV1
import DataStandard.Utils

-- | A published price for a single feed, stored directly. No observers: a
-- non-stakeholder reader obtains the contract by explicit disclosure and reads
-- it through an interface's `_Fetch` choice.
template DirectQuote
  with
    oracle      : Party
      -- ^ The distributor; signs and owns the publication.
    feedId      : Text
      -- ^ The feed, as named by the typed view.
    assetPair   : Text
      -- ^ The same feed under the key the generic payload uses. Held separately
      -- so each view can name the feed by its own convention; a distributor
      -- serving one feed sets them equal.
    price       : Decimal
    priceTime   : Time
      -- ^ The market time the price is observed for.
    publishedAt : Time
      -- ^ When the quote was produced.
  where
    signatory oracle

    interface instance PublishedQuote for DirectQuote where
      view = PublishedQuoteView with
        distributor = oracle
        quote = Quote with
          feedId
          price
          priceTime
        publishedAt
        metadata    = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    interface instance PublishedDataPoint for DirectQuote where
      view = PublishedDataPointView with
        distributor   = oracle
        publishedAt
        schemaVersion = "1.0.0"
        values        = insertField "assetPair" assetPair
                      $ insertField "price"     price
                        TM.empty
        metadata      = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    -- | Publish a fresh quote by archiving this contract and creating its
    -- replacement, so a consumer holding the old contract id fails fast.
    choice UpdateDirectQuote : ContractId DirectQuote
      with
        newPrice       : Decimal
        newPriceTime   : Time
        newPublishedAt : Time
      controller oracle
      do
        assertMsg "publication time must increase" (newPublishedAt > publishedAt)
        create this with
          price       = newPrice
          priceTime   = newPriceTime
          publishedAt = newPublishedAt
