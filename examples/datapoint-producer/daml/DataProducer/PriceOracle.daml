-- | A reference producer. A distributor's whole obligation is what this module
-- does: implement `PublishedDataPoint` on a template it signs.
module DataProducer.PriceOracle where

import qualified DA.TextMap as TM

import DataStandard.DataPointV1
import DataStandard.Utils

-- | A published asset-pair price.
--
-- No observers, on purpose: a reader that is not a stakeholder obtains the
-- contract by explicit disclosure and reads it through
-- `PublishedDataPoint_Fetch`, so publishing costs the same at any audience size.
template PublishedPrice
  with
    oracle    : Party
      -- ^ The distributor; signs and owns the publication.
    assetPair : Text
    price     : Decimal
    at        : Time
      -- ^ When the price was produced.
  where
    signatory oracle

    interface instance PublishedDataPoint for PublishedPrice where
      view = PublishedDataPointView with
        distributor   = oracle
        publishedAt   = at
        schemaVersion = "1.0.0"
        values        = insertField "assetPair" assetPair
                      $ insertField "price"     price
                        TM.empty
        metadata      = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    -- | Publish a fresh price by archiving this contract and creating its
    -- replacement, so a consumer holding the old contract id fails fast instead
    -- of reading a stale price. Revocation is the same with no replacement.
    choice UpdatePrice : ContractId PublishedPrice
      with
        newPrice : Decimal
        newAt    : Time
      controller oracle
      do
        assertMsg "publication time must increase" (newAt > at)
        create this with price = newPrice, at = newAt
