-- | A reference producer for the Data Standard. A distributor's obligation is
-- one thing, and this module is all of it: implement `PublishedDataPoint` on a
-- template the distributor signs. A consumer of the standard reads the result
-- without depending on this package.
module DataProducer.PriceOracle where

import qualified DA.TextMap as TM

import DataStandard.DataPointV1
import DataStandard.Utils

-- | A published asset-pair price.
--
-- The template has no observers, on purpose. A reader that is not a stakeholder
-- obtains the contract through explicit disclosure and reads it by exercising
-- `PublishedDataPoint_Fetch`, so publishing costs the same whether one consumer
-- reads the price or a thousand do.
template PublishedPrice
  with
    oracle    : Party
      -- ^ The distributor; signs and owns the publication.
    assetPair : Text
      -- ^ The feed this price is for, for example "BTC/USD".
    price     : Decimal
    at        : Time
      -- ^ When the price was produced.
  where
    signatory oracle

    interface instance PublishedDataPoint for PublishedPrice where
      view = PublishedDataPointView with
        distributor   = oracle
        publishedAt   = at
        schemaVersion = "1.0.0"
        values        = insertField "assetPair" assetPair
                      $ insertField "price"     price
                        TM.empty
        metadata      = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    -- | Publish a fresh price by archiving this contract and creating its
    -- replacement. Archiving the old publication is what makes a consumer
    -- holding its contract id fail fast instead of reading a stale price.
    -- Revoking a feed is the same operation with no replacement created.
    choice UpdatePrice : ContractId PublishedPrice
      with
        newPrice : Decimal
        newAt    : Time
          -- ^ Must be later than the current `at`.
      controller oracle
      do
        assertMsg "publication time must increase" (newAt > at)
        create this with price = newPrice, at = newAt
