-- | A reference consumer for the pull path: verify-and-use in one transaction.
-- The buyer supplies a payload the distributor signed off-ledger, the choice
-- reads the distributor's published key, verifies the payload with
-- `DataStandard.Codecs.Verify`, and settles at the verified price. A failed
-- verification aborts the transaction, so no settlement can exist against an
-- unverified price.
--
-- This package does not set `-Wno-crypto-text-is-alpha` and does not need to:
-- calling a library function that imports the alpha builtins internally is an
-- ordinary function call.
module DistributorKeyConsumer.Trading where

import DA.Time (RelTime, subTime)

import DataStandard.Codecs.Verify (verifyQuote)
import DataStandard.DistributorKeyV1
import DataStandard.Utils (SignedQuote)

-- | An offer to trade `quantity` of `feedId` at whatever price a quote signed by
-- the trusted distributor carries.
template SignedQuoteTradeOffer
  with
    seller : Party
    buyer : Party
      -- ^ The counterparty who accepts and supplies the signed quote.
    feedId : Text
      -- ^ The feed the buyer expects. Checked against the verified quote,
      -- because the standard authenticates the signer, not the feed: one key
      -- signs every feed the distributor publishes.
    quantity : Decimal
    expectedDistributor : Party
      -- ^ The one distributor whose price the buyer accepts. Verification makes
      -- the reported `distributor` authentic; trusting that party is the
      -- consumer's decision.
    maxQuoteAge : RelTime
      -- ^ The largest age, now minus `publishedAt`, the buyer will settle on.
      -- The signed `expiresAt` is the standard's only replay bound; this is the
      -- consumer's tighter policy on top of it.
    keyCid : ContractId DistributorKey
      -- ^ The distributor's published key, through the interface. The buyer
      -- obtains it by explicit disclosure when accepting.
  where
    signatory seller
    observer buyer

    -- | Settle at the price of a distributor-signed quote, in the buyer's
    -- transaction. The key is read by exercising `DistributorKey_Fetch`, not by
    -- `fetch`: disclosure grants visibility but not the authority a `fetch`
    -- needs. The gates run in order: the key belongs to the pinned distributor,
    -- the payload verifies (codec, window, signature, with the library's
    -- messages propagating unchanged), the feed matches, and the quote is
    -- neither future-dated nor beyond the buyer's staleness policy.
    choice AcceptSignedQuoteTrade : ContractId SignedQuoteTradeSettlement
      with
        payload : SignedQuote
        signature : Text
          -- ^ The distributor's signature over the payload's structural hash.
      controller buyer
      do
        now <- getTime
        kv <- exercise keyCid DistributorKey_Fetch with actor = buyer
        assertMsg "untrusted distributor" (kv.distributor == expectedDistributor)
        case verifyQuote kv now payload signature of
          Left err -> abort err
          Right v -> do
            assertMsg "feed mismatch" (v.quote.feedId == feedId)
            assertMsg "quote published in the future" (v.publishedAt <= now)
            assertMsg "quote too stale" (subTime now v.publishedAt <= maxQuoteAge)
            create SignedQuoteTradeSettlement with
              seller, buyer, feedId, quantity
              price = v.quote.price
              totalAmount = v.quote.price * quantity
              distributor = v.distributor
              priceTime = v.quote.priceTime
              publishedAt = v.publishedAt
              verifiedAt = now
              expiresAt = payload.expiresAt
              canonicalHash = v.canonicalHash
              signature = v.signature
              publicKey = v.publicKey

    choice CancelOffer : ()
      controller seller
      do pure ()

-- | The record of a settled trade. It keeps the signed validity window and the
-- `canonicalHash`/`signature`/`publicKey` evidence, so the trade record alone
-- is enough to re-verify the price off-ledger later, without the distributor's
-- package and without the key contract still being active. `canonicalHash` is
-- the durable join key; a contract id is not, since rotation changes it.
template SignedQuoteTradeSettlement
  with
    seller : Party
    buyer : Party
      -- ^ The accepting party, and the one that performed the verification.
    feedId : Text
    quantity : Decimal
    price : Decimal
      -- ^ The verified price the trade settled at.
    totalAmount : Decimal
    distributor : Party
      -- ^ The distributor whose signature authenticated the price.
    priceTime : Time
      -- ^ The market instant the price was observed for.
    publishedAt : Time
      -- ^ When the distributor produced the quote.
    verifiedAt : Time
      -- ^ The ledger time the verification succeeded.
    expiresAt : Time
      -- ^ The signed expiry the verification checked; part of the hashed
      -- envelope, so it is needed to reproduce the check.
    canonicalHash : Text
      -- ^ The structural root hash the signature committed to.
    signature : Text
    publicKey : Text
  where
    signatory seller, buyer
