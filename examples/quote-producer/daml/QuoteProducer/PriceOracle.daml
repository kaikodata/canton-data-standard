-- | A reference producer for the Data Standard's `PublishedQuote` interface.
-- All a distributor has to do is what this module does: implement
-- `PublishedQuote` on a template the distributor signs. A consumer of the
-- standard reads the result without depending on this package.
module QuoteProducer.PriceOracle where

import qualified DA.TextMap as TM

import DataStandard.QuoteV1
import DataStandard.Utils

-- | A published price quote for a single feed.
--
-- No observers, on purpose: a reader that is not a stakeholder gets the
-- contract by explicit disclosure and reads it through `PublishedQuote_Fetch`.
-- Publishing therefore costs the same however large the audience is.
template PriceQuote
  with
    oracle      : Party
      -- ^ The distributor; signs and owns the publication.
    feedId      : Text
      -- ^ The feed this quote is for, for example "BTC/USD".
    price       : Decimal
    priceTime   : Time
      -- ^ The market time the price is observed for.
    publishedAt : Time
      -- ^ When the quote was produced.
  where
    signatory oracle

    interface instance PublishedQuote for PriceQuote where
      view = PublishedQuoteView with
        distributor = oracle
        quote = Quote with
          feedId
          price
          priceTime
        publishedAt
        metadata    = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    -- | Publish a fresh quote by archiving this contract and creating its
    -- replacement. A consumer still holding the archived contract's id fails
    -- fast, which is preferable to it reading a stale quote. Revocation is the
    -- same operation with no replacement created.
    choice UpdateQuote : ContractId PriceQuote
      with
        newPrice       : Decimal
        newPriceTime   : Time
        newPublishedAt : Time
          -- ^ Must be later than the current `publishedAt`.
      controller oracle
      do
        assertMsg "publication time must increase" (newPublishedAt > publishedAt)
        create this with
          price       = newPrice
          priceTime   = newPriceTime
          publishedAt = newPublishedAt
