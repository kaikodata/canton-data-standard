-- | A reference producer for a price quote. There is no quote interface: a
-- quote is a `PublishedDataPoint` at the quote schema, so this module
-- implements the one interface the standard defines and lets
-- `DataStandard.Codecs.Quote` turn the typed value into the payload. A
-- distributor's whole obligation is still what this module does — implement the
-- interface on a template it signs.
module QuoteProducer.PriceOracle where

import qualified DA.TextMap as TM

import DataStandard.Codecs.Quote (Quote(..), quoteSchemaVersion, quoteToValues)
import DataStandard.DataPointV1
import DataStandard.Utils

-- | A published price quote for a single feed.
--
-- No observers, on purpose: a reader that is not a stakeholder obtains the
-- contract by explicit disclosure and reads it through
-- `PublishedDataPoint_Fetch`, so publishing costs the same at any audience size.
template PriceQuote
  with
    oracle      : Party
      -- ^ The distributor; signs and owns the publication.
    feedId      : Text
    price       : Decimal
    priceTime   : Time
      -- ^ The market time the price is observed for.
    publishedAt : Time
      -- ^ When the quote was produced.
  where
    signatory oracle

    interface instance PublishedDataPoint for PriceQuote where
      view = PublishedDataPointView with
        distributor   = oracle
        publishedAt
        schemaVersion = quoteSchemaVersion
        values        = quoteToValues Quote with
          feedId
          price
          priceTime
        metadata      = Metadata with
          values = TM.fromList [("exampleoracle.com/source", "reference-implementation")]

    -- | Publish a fresh quote by archiving this contract and creating its
    -- replacement, so a consumer holding the old contract id fails fast instead
    -- of reading a stale quote. Revocation is the same with no replacement.
    choice UpdateQuote : ContractId PriceQuote
      with
        newPrice       : Decimal
        newPriceTime   : Time
        newPublishedAt : Time
      controller oracle
      do
        assertMsg "publication time must increase" (newPublishedAt > publishedAt)
        create this with
          price       = newPrice
          priceTime   = newPriceTime
          publishedAt = newPublishedAt
