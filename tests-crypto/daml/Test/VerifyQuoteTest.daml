-- | Tests for `verifyQuote`/`verifyQuoteWith` against real secp256k1 keys. Each
-- script generates a keypair with `secp256k1generatekeypair`, signs a payload's
-- structural root hash with `secp256k1sign`, and checks the result through the
-- library.
--
-- Verification is a pure function, so `now` is passed in explicitly instead of
-- being read from the ledger. The tests exploit that: every time in this module
-- is a fixed epoch-millisecond value, so no assertion depends on when the suite
-- runs. The payload is the golden `gvQuoteTyped` quote, chosen to tie the
-- signature checks to the normative vector. A change to the envelope that broke
-- the vector would also break the `canonicalHash` assertions here.
--
-- The failure messages are asserted exactly, because they are part of the
-- library's public surface: a consumer that aborts on them propagates them
-- unchanged, so a reworded message is a breaking change for consumers.
--
-- Daml Script's crypto helpers run in-memory only, which is why this suite is
-- separate from the live-runner `tests` package.
module Test.VerifyQuoteTest where

import DA.Assert ((===))
import DA.Time (addRelTime, milliseconds)
import Daml.Script

import DataStandard.Codecs.Envelope
  ( dataPointHashCodecId, hashSignedQuote, quoteHashCodecId )
import DataStandard.Codecs.StructuralHash (epoch)
import DataStandard.Codecs.Verify (verifyQuote, verifyQuoteWith)
import DataStandard.DistributorKeyV1 (DistributorKeyView(..))
import DataStandard.Utils (Quote(..), SignedQuote(..))

fromMillis : Int -> Time
fromMillis ms = addRelTime epoch (milliseconds ms)

-- T0/T1 from the vector contract: the publication and expiry instants of the
-- golden quote envelope.
t0 : Time
t0 = fromMillis 1768480245000

t1 : Time
t1 = fromMillis 1768483845000

-- | The golden quote payload, whose root hash is the normative `gvQuoteTyped`.
goldenPayload : SignedQuote
goldenPayload = SignedQuote with
  publishedAt = t0
  expiresAt = t1
  quote = Quote with
    feedId = "BTC/USD"
    price = 65000.0
    priceTime = t0

-- | The normative root hash of `goldenPayload`, restated here so a regression in
-- the envelope surfaces in this suite too and not only in `tests-codecs`.
goldenPayloadHash : Text
goldenPayloadHash = "c6ef3856385d967474f7c84b2822b43c689ce5fd233e85c0d76680e3c907f138"

-- | A distributor, a real keypair, and a signature over `goldenPayload`.
data QuoteFixture = QuoteFixture with
    distributor : Party
    keyPair : Secp256k1KeyPair
    signature : Text

setupQuote : Script QuoteFixture
setupQuote = do
  distributor <- allocateParty "Distributor"
  keyPair <- secp256k1generatekeypair
  signature <- signQuote keyPair.privateKey goldenPayload
  pure QuoteFixture with distributor, keyPair, signature

-- | Sign a payload the way a distributor's off-ledger signer does: ECDSA over the
-- structural root hash. `secp256k1sign` treats its message argument exactly as the
-- on-ledger `secp256k1` builtin does, so a signature made here is one the builtin
-- accepts.
signQuote : Text -> SignedQuote -> Script Text
signQuote privateKey payload =
  secp256k1sign privateKey (hashSignedQuote payload).value

-- | A published key naming this library's quote envelope.
quoteKeyView : Party -> Text -> DistributorKeyView
quoteKeyView distributor publicKey = DistributorKeyView with
  distributor
  publicKey
  signMethod = "secp256k1"
  hashMethod = "SHA-256"
  payloadCodec = quoteHashCodecId

expectLeft : Text -> Either Text a -> Script ()
expectLeft expected result = case result of
  Left err -> err === expected
  Right _ -> abort ("expected failure: " <> expected)

expectRight : Either Text a -> Script a
expectRight result = case result of
  Left err -> abort ("expected success, got: " <> err)
  Right v -> pure v

-- A valid signature verifies, and the result carries the quote field-aligned with
-- the pushed view plus the evidence triple. `canonicalHash` is the structural root
-- hash, which is the normative golden vector.
testVerifyQuoteHappyPath : Script ()
testVerifyQuoteHappyPath = do
  f <- setupQuote
  v <- expectRight (verifyQuoteWith f.distributor f.keyPair.publicKey t0 goldenPayload f.signature)
  v.distributor === f.distributor
  v.publishedAt === t0
  v.quote === goldenPayload.quote
  v.quote.price === 65000.0
  v.canonicalHash === goldenPayloadHash
  v.signature === f.signature
  v.publicKey === f.keyPair.publicKey

-- The view overload reads the distributor and the key off the published key, so a
-- consumer never supplies either itself.
testVerifyQuoteThroughKeyView : Script ()
testVerifyQuoteThroughKeyView = do
  f <- setupQuote
  let key = quoteKeyView f.distributor f.keyPair.publicKey
  v <- expectRight (verifyQuote key t0 goldenPayload f.signature)
  v.distributor === f.distributor
  v.publicKey === f.keyPair.publicKey
  v.canonicalHash === goldenPayloadHash

-- The validity window is closed at both ends: the expiry instant itself still
-- verifies, and any later instant does not.
testExpiryBoundaryIsInclusive : Script ()
testExpiryBoundaryIsInclusive = do
  f <- setupQuote
  v <- expectRight (verifyQuoteWith f.distributor f.keyPair.publicKey t1 goldenPayload f.signature)
  v.canonicalHash === goldenPayloadHash
  expectLeft "payload expired"
    (verifyQuoteWith f.distributor f.keyPair.publicKey (addRelTime t1 (milliseconds 1))
      goldenPayload f.signature)

-- A window that ends before it begins is never live, and is rejected before the
-- clock is consulted at all.
testPublishedAfterExpiryRejected : Script ()
testPublishedAfterExpiryRejected = do
  distributor <- allocateParty "Distributor"
  keyPair <- secp256k1generatekeypair
  let payload = goldenPayload with publishedAt = t1, expiresAt = t0
  signature <- signQuote keyPair.privateKey payload
  -- Genuinely signed, and still refused: the check is on the payload's own
  -- coherence, not on the signature.
  expectLeft "published after expiry"
    (verifyQuoteWith distributor keyPair.publicKey t0 payload signature)

-- Expiry is the standard's sole replay defence: the same (payload, signature) pair
-- that verified inside the window stops verifying past it.
testExpiredPayloadRejected : Script ()
testExpiredPayloadRejected = do
  f <- setupQuote
  _ <- expectRight (verifyQuoteWith f.distributor f.keyPair.publicKey t0 goldenPayload f.signature)
  expectLeft "payload expired"
    (verifyQuoteWith f.distributor f.keyPair.publicKey (addRelTime t1 (milliseconds 1))
      goldenPayload f.signature)

-- A signature is bound to the exact payload it was made over. Editing the price
-- leaves a well-formed DER signature that no longer matches.
testTamperedPriceRejected : Script ()
testTamperedPriceRejected = do
  f <- setupQuote
  let tampered = goldenPayload with
        quote = goldenPayload.quote with price = 66000.0
  expectLeft "invalid signature"
    (verifyQuoteWith f.distributor f.keyPair.publicKey t0 tampered f.signature)

-- Every signed field is covered, not just the price: the feed and the validity
-- window are inside the hash too.
testTamperedFeedAndWindowRejected : Script ()
testTamperedFeedAndWindowRejected = do
  f <- setupQuote
  expectLeft "invalid signature"
    (verifyQuoteWith f.distributor f.keyPair.publicKey t0
      (goldenPayload with quote = goldenPayload.quote with feedId = "ETH/USD") f.signature)
  expectLeft "invalid signature"
    (verifyQuoteWith f.distributor f.keyPair.publicKey t0
      (goldenPayload with expiresAt = addRelTime t1 (milliseconds 1000)) f.signature)

-- A signature from another key does not verify: the key is what authenticates the
-- distributor, so a valid signature by the wrong signer is no signature at all.
testWrongKeyRejected : Script ()
testWrongKeyRejected = do
  f <- setupQuote
  other <- secp256k1generatekeypair
  expectLeft "invalid signature"
    (verifyQuoteWith f.distributor other.publicKey t0 goldenPayload f.signature)
  otherSig <- signQuote other.privateKey goldenPayload
  expectLeft "invalid signature"
    (verifyQuoteWith f.distributor f.keyPair.publicKey t0 goldenPayload otherSig)

-- A key published for a different envelope is refused instead of being checked
-- against the wrong hash, and the codec is checked before anything else.
testUnsupportedCodecRejected : Script ()
testUnsupportedCodecRejected = do
  f <- setupQuote
  let dataPointKey = (quoteKeyView f.distributor f.keyPair.publicKey) with
        payloadCodec = dataPointHashCodecId
  expectLeft "unsupported payload codec" (verifyQuote dataPointKey t0 goldenPayload f.signature)
  -- Checked first: a payload that would also fail its window still reports the
  -- codec, so the caller learns the key is the wrong one.
  let productKey = (quoteKeyView f.distributor f.keyPair.publicKey) with
        payloadCodec = "some-product-codec"
  expectLeft "unsupported payload codec"
    (verifyQuote productKey (addRelTime t1 (milliseconds 1)) goldenPayload f.signature)
