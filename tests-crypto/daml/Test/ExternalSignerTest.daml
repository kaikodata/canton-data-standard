-- | The cross-language signer path: signatures produced entirely outside Daml
-- verify through this library, unchanged. Every other crypto test signs with
-- Daml Script's helpers, which says nothing about a third-party signer. Here
-- both the hash and the ECDSA signature come from elsewhere: the data point
-- fixture from a Python reference (pyca/cryptography) over the normative
-- `gvEnvelope` payload, the quote fixture from the Go signer in
-- `pkg/cantonpulloracle` over `goFixtureQuoteHash`, both with RFC 6979 nonces.
--
-- No constant below may be regenerated to make a test pass: a failure means
-- this library has diverged from the scheme the fixtures were made under.
module Test.ExternalSignerTest where

import DA.Assert ((===))
import qualified DA.TextMap as TM
import DA.Time (addRelTime, milliseconds)
import Daml.Script

import DataStandard.Codecs.Envelope (hashSignedDataPoint)
import DataStandard.Codecs.Quote (Quote(..), signedQuote, verifiedQuote)
import DataStandard.Codecs.StructuralHash (epoch)
import DataStandard.Codecs.Verify (verifyDataPointWith)
import DataStandard.Utils (AnyValue(..), SignedDataPoint(..))

fromMillis : Int -> Time
fromMillis ms = addRelTime epoch (milliseconds ms)

t0 : Time
t0 = fromMillis 1768480245000

t1 : Time
t1 = fromMillis 1768483845000

-- | The exact payload the Python reference hashed and signed: the normative
-- `gvEnvelope` data point envelope.
pythonPayload : SignedDataPoint
pythonPayload = SignedDataPoint with
  publishedAt = t0
  expiresAt = t1
  schemaVersion = "1.0.0"
  values = TM.fromList [("feedId", AVText "EUR/USD"), ("rate", AVDecimal 1.0875)]

-- | `gvEnvelope`: the root hash the Python implementation computed independently.
pythonPayloadHash : Text
pythonPayloadHash = "1ac5fa4ba0227c3e348464699c40b5f313ffbae4c12943e544d2e44d176b575c"

-- | Produced by the Python reference signer (pyca/cryptography): a secp256k1 public
-- key in hex DER-SPKI form. No Daml code ever held the matching private key.
pythonPubKey : Text
pythonPubKey = "3056301006072a8648ce3d020106052b8104000a034200041c05f66cb995dcfb3742bc22dcd7f48d2c8cdbb1314fc8a6eec55120708ac667651e2db08cc4924d42e99cdf9d1544c86b30b13a31e1c824dce2c7af9f58e12d"

-- | Produced by the Python reference signer: ECDSA over sha256 of the root hash's
-- bytes, DER-encoded and hex-encoded.
pythonSig : Text
pythonSig = "3046022100c3360531fcaefdadd486dc094fa870dbb35c1d34643124b8e33cd9bae8f6312f022100e64a75f6e13a1060b4a850b3395a1ad0e080015dcfd7f9e6212b444c1fa34e69"

expectLeft : Text -> Either Text a -> Script ()
expectLeft expected result = case result of
  Left err -> err === expected
  Right _ -> abort ("expected failure: " <> expected)

expectRight : Either Text a -> Script a
expectRight result = case result of
  Left err -> abort ("expected success, got: " <> err)
  Right v -> pure v

-- The two implementations agree on the hash before any signature is considered.
-- Asserted separately so a divergence is diagnosable: a failure here is a hash
-- mismatch, a failure below is a signature mismatch.
testExternalHashesAgree : Script ()
testExternalHashesAgree =
  (hashSignedDataPoint pythonPayload).value === pythonPayloadHash

-- A signature made entirely outside Daml verifies through the library, and the
-- result reports the same root hash as its `canonicalHash`.
testPythonSignatureVerifies : Script ()
testPythonSignatureVerifies = do
  distributor <- allocateParty "PythonDistributor"
  v <- expectRight (verifyDataPointWith distributor pythonPubKey t0 pythonPayload pythonSig)
  v.distributor === distributor
  v.schemaVersion === "1.0.0"
  TM.lookup "rate" v.values === Some (AVDecimal 1.0875)
  v.canonicalHash === pythonPayloadHash
  v.publicKey === pythonPubKey
  v.signature === pythonSig

-- The external signature stays bound to the payload it was made over: an edited
-- rate, an edited schema, and an edited window are each refused.
testPythonSignatureBoundToPayload : Script ()
testPythonSignatureBoundToPayload = do
  distributor <- allocateParty "PythonDistributor"
  let check payload = expectLeft "invalid signature"
        (verifyDataPointWith distributor pythonPubKey t0 payload pythonSig)
  check (pythonPayload with values = TM.insert "rate" (AVDecimal 1.0876) pythonPayload.values)
  check (pythonPayload with schemaVersion = "1.0.1")
  check (pythonPayload with expiresAt = addRelTime t1 (milliseconds 1000))

-- The external key verifies only its own implementation's signature, which rules
-- out the fixture passing because the check is lax.
testForeignSignatureRejected : Script ()
testForeignSignatureRejected = do
  distributor <- allocateParty "Distributor"
  other <- secp256k1generatekeypair
  otherSig <- secp256k1sign other.privateKey pythonPayloadHash
  expectLeft "invalid signature"
    (verifyDataPointWith distributor pythonPubKey t0 pythonPayload otherSig)
  expectLeft "invalid signature"
    (verifyDataPointWith distributor other.publicKey t0 pythonPayload pythonSig)

-- An externally signed payload is still subject to the validity window. However
-- good its signature is, an expired payload is refused.
testExternalSignaturesRespectExpiry : Script ()
testExternalSignaturesRespectExpiry = do
  distributor <- allocateParty "Distributor"
  expectLeft "payload expired"
    (verifyDataPointWith distributor pythonPubKey (addRelTime t1 (milliseconds 1))
      pythonPayload pythonSig)

-- Quote side: the Go fixture
------------------------------------------------------------

-- | The exact payload the Go signer hashed and signed: a quote on the data point
-- envelope, built the way `signedQuote` builds one. Note the half-second
-- `priceTime`, representable in epoch milliseconds, which is why this fixture
-- cannot be built from a whole-second calendar time.
goPayload : SignedDataPoint
goPayload = signedQuote (fromMillis 1717000005000) (fromMillis 1717000605000) Quote with
  feedId = "KK_RFR_EURUSD"
  price = 1.0825
  priceTime = fromMillis 1717000004500

-- | The root hash the Go implementation computed independently, and the value
-- `Test.GoldenVectorsTest.goFixtureQuoteHash` pins on this side.
goPayloadHash : Text
goPayloadHash = "8c71740fd3f4759759bc1b2bebf821d6dcbe80bf59418b764504b3930788b141"

-- | Produced by the Go signer in `pkg/cantonpulloracle`
-- (`TestGoldenSignatureFixtures`): its test key as hex DER-SPKI.
goSignerPubKey : Text
goSignerPubKey = "3056301006072a8648ce3d020106052b8104000a034200043432ed27a36d76b5badc2f5171413ba858dc7a53a78df3caeb439f1e81b11210b5f55e741b31fae62c9aeb1300e514c42a2f5fcd995994ba82b2547150417ae7"

-- | Produced by the Go signer in `pkg/cantonpulloracle`
-- (`TestGoldenSignatureFixtures`): ECDSA over `goPayloadHash`, with libsecp256k1
-- RFC 6979 deterministic nonces, DER-encoded and hex-encoded.
goQuoteSig : Text
goQuoteSig = "304402203f02995386e13bd1364d80ab1559c6ea4db049ef8f26f29bdac2def1d24b4bf8022046910352d24e1dc8acf617590b9ab8524282ab2184a7a8b5519698c1193c8002"

-- The Go signer and this library agree on the hash before any signature is
-- considered, so a divergence is diagnosable: a failure here is a hash mismatch,
-- a failure below is a signature mismatch.
testGoHashAgrees : Script ()
testGoHashAgrees =
  (hashSignedDataPoint goPayload).value === goPayloadHash

-- A quote signature produced by the Go signer verifies through the library, and
-- the authenticated payload decodes back to the quote that was signed. This is
-- the fixture that pins the Daml verifier and the production Go signer to one
-- shared vector, instead of to two vectors that happen to agree.
testGoQuoteSignatureVerifies : Script ()
testGoQuoteSignatureVerifies = do
  distributor <- allocateParty "GoDistributor"
  v <- expectRight (verifyDataPointWith distributor goSignerPubKey (fromMillis 1717000005000) goPayload goQuoteSig)
  v.distributor === distributor
  v.canonicalHash === goPayloadHash
  v.publicKey === goSignerPubKey
  v.signature === goQuoteSig
  q <- expectRight (verifiedQuote v)
  q.feedId === "KK_RFR_EURUSD"
  q.price === 1.0825
  q.priceTime === fromMillis 1717000004500

-- The Go signature is bound to its payload: every field inside the quote is
-- covered, because the quote's values are inside the hashed payload.
testGoQuoteSignatureBoundToPayload : Script ()
testGoQuoteSignatureBoundToPayload = do
  distributor <- allocateParty "GoDistributor"
  let t0 = fromMillis 1717000005000
      t1 = fromMillis 1717000605000
      base = Quote with
        feedId = "KK_RFR_EURUSD"
        price = 1.0825
        priceTime = fromMillis 1717000004500
      check payload = expectLeft "invalid signature"
        (verifyDataPointWith distributor goSignerPubKey t0 payload goQuoteSig)
  check (signedQuote t0 t1 (base with price = 1.0826))
  check (signedQuote t0 t1 (base with feedId = "KK_RFR_EURCHF"))
  check (signedQuote t0 t1 (base with priceTime = addRelTime base.priceTime (milliseconds 1)))
  check (goPayload with expiresAt = addRelTime t1 (milliseconds 1000))

-- The two external fixtures are not interchangeable: each key verifies only its
-- own implementation's signature, which rules out one passing because the check
-- is lax.
testExternalFixturesDoNotCrossVerify : Script ()
testExternalFixturesDoNotCrossVerify = do
  distributor <- allocateParty "Distributor"
  expectLeft "invalid signature"
    (verifyDataPointWith distributor pythonPubKey (fromMillis 1717000005000) goPayload goQuoteSig)
  expectLeft "invalid signature"
    (verifyDataPointWith distributor goSignerPubKey t0 pythonPayload pythonSig)
