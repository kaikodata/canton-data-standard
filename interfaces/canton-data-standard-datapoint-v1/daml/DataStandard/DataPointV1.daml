-- | The generic data point interface. A distributor implements
-- `PublishedDataPoint` on its own template to publish key/value market data; a
-- consumer reads it through the interface, without depending on the
-- distributor's package.
module DataStandard.DataPointV1 where

import DataStandard.Utils (Metadata, Values)

-- | The view every `PublishedDataPoint` implementation exposes.
data PublishedDataPointView = PublishedDataPointView with
    distributor : Party
      -- ^ The party that published the data, and whom the consumer chooses to
      -- trust as its source.
    publishedAt : Time
      -- ^ When the distributor produced the data, which is not necessarily when
      -- the contract was created.
    schemaVersion : Text
      -- ^ Semantic version of the `values` schema. It describes a given feed's
      -- payload and evolves per distributor, independently of the interface
      -- version in this package's name.
    values : Values
      -- ^ The payload, as a map of field names to tagged values.
    metadata : Metadata
      -- ^ Additive annotations that are not part of the data itself.
  deriving (Eq, Show)

interface PublishedDataPoint where
  viewtype PublishedDataPointView

  -- | Read the view from a contract the caller can see. A party holding the
  -- contract by explicit disclosure is not a stakeholder and so cannot `fetch`
  -- it; this choice is authorised by the caller alone, and returns the view
  -- rather than the implementing template.
  nonconsuming choice PublishedDataPoint_Fetch : PublishedDataPointView
    with
      actor : Party
        -- ^ The party reading the data, and the sole controller of the choice.
    controller actor
    do pure (view this)
