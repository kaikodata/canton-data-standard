-- | The generic data point interface of the Data Standard. A distributor
-- implements `PublishedDataPoint` on its own template to publish arbitrary
-- key/value market data; a consumer reads it through the interface without
-- depending on the distributor's package.
module DataStandard.DataPointV1 where

import DataStandard.Utils (Metadata, Values)

-- | The on-ledger view every `PublishedDataPoint` implementation exposes. A
-- consumer reads only these fields, and is therefore decoupled from the
-- template that produced them.
data PublishedDataPointView = PublishedDataPointView with
    distributor : Party
      -- ^ The party that published the data, and whom the consumer chooses to
      -- trust as its source.
    publishedAt : Time
      -- ^ When the distributor produced the data, which is not necessarily when
      -- the contract was created.
    schemaVersion : Text
      -- ^ Version of the `values` schema, using semantic versioning. It
      -- describes a given feed's payload and evolves per distributor,
      -- independently of the interface version in this package's name.
    values : Values
      -- ^ The data point's payload, as a map of field names to tagged values.
    metadata : Metadata
      -- ^ Additive annotations that are not part of the data itself; see
      -- `Metadata`. `emptyMetadata` when the distributor has nothing to attach.
  deriving (Eq, Show)

-- | The generic data point interface. A distributor implements it on its own
-- template; consumers read the view through it and never import the
-- distributor's package, so switching distributor is a configuration change
-- and not a recompile.
interface PublishedDataPoint where
  viewtype PublishedDataPointView

  -- | Read the view from a contract the caller can see. This is the read path
  -- for a party that is not a stakeholder of the contract: such a party
  -- obtains the contract through explicit disclosure, which grants visibility
  -- but not the authority to `fetch`, and so reads by exercising this choice,
  -- which the caller alone authorises. The choice is nonconsuming, and what it
  -- returns is the view, not the implementing template.
  nonconsuming choice PublishedDataPoint_Fetch : PublishedDataPointView
    with
      actor : Party
        -- ^ The party reading the data, and the sole controller of the choice.
    controller actor
    do pure (view this)
