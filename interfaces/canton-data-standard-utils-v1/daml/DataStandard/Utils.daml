-- | Shared value types for the Data Standard's payloads. Every Data Standard
-- interface package depends on this package, as do the applications that
-- implement or consume those interfaces.
module DataStandard.Utils where

import DA.TextMap (TextMap)
import qualified DA.TextMap as TM

-- | The closed, recursive set of values that may appear in a `Values` payload.
-- The set is the scalars plus an ordered list and a string-keyed map, so a
-- value can nest other values and a structured payload such as an index's
-- constituents is expressible. Which constructors exist is decided by the Data
-- Standard; an individual distributor cannot add one.
--
-- Closing the set that way gives every value a single canonical hash, which is
-- what signature-based delivery relies on when it reconstructs a payload
-- on-ledger to check a distributor's signature. The
-- `canton-data-standard-codecs` package defines that hash. Contract-based
-- (push) delivery needs no hash at all, since the ledger serializes the
-- payload itself.
data AnyValue
  = AVInt Int
  | AVDecimal Decimal
  | AVText Text
  | AVTime Time
  | AVBool Bool
  | AVList [AnyValue]
  | AVMap (TextMap AnyValue)
  deriving (Eq, Show)

-- | A data point's payload: a map from field name to tagged value. Which field
-- names a given feed is expected to have, and at which types, is defined by the
-- `schemaVersion` on the view that exposes the payload.
type Values = TextMap AnyValue

-- | Conversion of a native Daml value into its `AnyValue` tag. An instance
-- exists for each type the closed set supports, which lets `insertField`
-- accept a native value without the caller naming a constructor.
class ToAnyValue a where
  toAny : a -> AnyValue

-- | Recovery of a native Daml value from its `AnyValue` tag. Returns `None`
-- when the tag holds a different type, so a consumer asking for the wrong type
-- gets `None` instead of a silently coerced value.
class FromAnyValue a where
  fromAny : AnyValue -> Optional a

instance ToAnyValue Int where toAny = AVInt
instance FromAnyValue Int where
  fromAny (AVInt i) = Some i
  fromAny _         = None

instance ToAnyValue Decimal where toAny = AVDecimal
instance FromAnyValue Decimal where
  fromAny (AVDecimal d) = Some d
  fromAny _             = None

instance ToAnyValue Text where toAny = AVText
instance FromAnyValue Text where
  fromAny (AVText t) = Some t
  fromAny _          = None

instance ToAnyValue Time where toAny = AVTime
instance FromAnyValue Time where
  fromAny (AVTime t) = Some t
  fromAny _          = None

instance ToAnyValue Bool where toAny = AVBool
instance FromAnyValue Bool where
  fromAny (AVBool b) = Some b
  fromAny _          = None

instance ToAnyValue AnyValue where toAny = identity
instance FromAnyValue AnyValue where fromAny = Some

instance ToAnyValue a => ToAnyValue [a] where
  toAny xs = AVList (map toAny xs)
instance FromAnyValue a => FromAnyValue [a] where
  fromAny (AVList xs) = sequenceOptional (map fromAny xs)
  fromAny _           = None

instance ToAnyValue a => ToAnyValue (TextMap a) where
  toAny m =
    let kvs  = TM.toList m
        kvs' = map (\(k, v) -> (k, toAny v)) kvs
    in AVMap (TM.fromList kvs')
instance FromAnyValue a => FromAnyValue (TextMap a) where
  fromAny (AVMap m) = traverseTextMap fromAny m
  fromAny _         = None

-- | A single price for a named feed, observed at a market instant. This is the
-- economic content of a quote and no more than that. Provenance (who published
-- it, and when) is an envelope concern, and belongs to the view that wraps a
-- `Quote`, so the same `Quote` value can be reused across views without
-- dragging distribution metadata along with it.
data Quote = Quote with
    feedId : Text
      -- ^ The price feed this quote is for, for example "BTC/USD". A consumer
      -- trusts a (distributor, feedId) pair; switching distributor is re-pointing
      -- it, with no recompile.
    price : Decimal
      -- ^ The quoted price for the feed, as an exact base-10 fixed-point number.
    priceTime : Time
      -- ^ The economic "as of" instant: the market time the price is observed
      -- for. This is the timestamp a consumer reasons about the price with. Set
      -- it equal to the view's `publishedAt` for a feed with no distinct
      -- observation time.
  deriving (Eq, Show)

-- | The record a client reconstructs and hands to the library's `verifyQuote`.
-- It is the exact set of fields the distributor signed off-ledger: the quote plus
-- the validity window the signature commits to. The signature itself travels
-- beside it as a separate argument, because it is taken over the hash of these
-- fields and so cannot also cover itself.
--
-- The record lives in this data-only package, not in the codec library, for two
-- reasons: every distributor and consumer then names one shape for a signed
-- quote, and a template may store it. A utility package makes its types
-- unserializable; a data-only package does not.
data SignedQuote = SignedQuote with
    publishedAt : Time
      -- ^ When the distributor produced and signed the quote. Becomes the
      -- `publishedAt` of the `VerifiedQuote`; carries the same meaning as
      -- `PublishedQuoteView.publishedAt`. A consumer uses it for staleness checks.
    expiresAt : Time
      -- ^ The instant after which the payload is no longer accepted. Verification
      -- rejects a payload presented strictly after this time; the boundary instant
      -- itself is still accepted. This is the sole replay defence: a captured
      -- (payload, signature) pair stops verifying once it lapses. Must be at or
      -- after `publishedAt`, since a window that ends before it begins is never
      -- live; verification rejects such a payload on "published after expiry"
      -- before reading the time.
    quote : Quote
      -- ^ The economic content: the feed, its price, and the market instant the
      -- price is observed for. Identical in meaning to `PublishedQuoteView.quote`.
  deriving (Eq, Show)

-- | The record a client reconstructs and hands to the library's
-- `verifyDataPoint`. It is the exact set of fields the distributor signed
-- off-ledger: the data point's payload plus the validity window the signature
-- commits to. The signature travels beside it, for the same reason it does on
-- `SignedQuote`.
data SignedDataPoint = SignedDataPoint with
    publishedAt : Time
      -- ^ When the distributor produced and signed the data point. Becomes the
      -- `publishedAt` of the `VerifiedDataPoint`; carries the same meaning as
      -- `PublishedDataPointView.publishedAt`. A consumer uses it for staleness
      -- checks.
    expiresAt : Time
      -- ^ The instant after which the payload is no longer accepted. Verification
      -- rejects a payload presented strictly after this time; the boundary instant
      -- itself is still accepted. This is the sole replay defence: a captured
      -- (payload, signature) pair stops verifying once it lapses. Must be at or
      -- after `publishedAt`, since a window that ends before it begins is never
      -- live; verification rejects such a payload on "published after expiry"
      -- before reading the time.
    schemaVersion : Text
      -- ^ Version of the `values` schema, using semantic versioning. Identical in
      -- meaning to `PublishedDataPointView.schemaVersion`: it describes a given
      -- feed's payload and evolves per distributor, independently of this
      -- package's version. Signed by the distributor and so committed to by the
      -- signature.
    values : Values
      -- ^ The data point's payload, a map of field names to tagged values.
      -- Identical in meaning to `PublishedDataPointView.values`. The recursive
      -- part of the signed input; the structural hash walks it in a fixed
      -- key-sorted order so the same payload always produces the same hash.
  deriving (Eq, Show)

-- | The in-memory result the library's `verifyQuote` returns on success. It has
-- no contract id of its own: a consumer uses the result directly in the same
-- transaction, and records whatever of it its own templates need. The leading
-- three fields are positionally and semantically aligned with
-- `PublishedQuoteView` (`distributor`, `publishedAt`, `quote`), so consumer code
-- reading a verified quote is identical to code reading a pushed one. The
-- trailing three are the evidence triple, retained so the verification can be
-- reproduced off-ledger.
data VerifiedQuote = VerifiedQuote with
    distributor : Party
      -- ^ The distributor whose key validated the signature, taken from the
      -- `DistributorKey` view (or from the caller's pinned argument on the
      -- `...With` overload). It is never read out of the payload, so a payload
      -- cannot claim a distributor it was not signed by.
    publishedAt : Time
      -- ^ Copied from the verified payload: when the distributor produced the
      -- quote.
    quote : Quote
      -- ^ Copied from the verified payload: the authenticated economic content.
    canonicalHash : Text
      -- ^ The structural root hash of the signed payload, hex-encoded. This is
      -- the digest the signature commits to; retained as evidence for off-ledger
      -- re-verification, and the durable join key for anything that must
      -- reference this verification.
    signature : Text
      -- ^ The verified signature, hex-encoded DER ECDSA. Retained as evidence.
    publicKey : Text
      -- ^ The public key the signature verified against. Retained as evidence so
      -- re-verification needs nothing else.
  deriving (Eq, Show)

-- | The in-memory result the library's `verifyDataPoint` returns on success. The
-- leading four fields are semantically aligned with `PublishedDataPointView`
-- (`distributor`, `publishedAt`, `schemaVersion`, `values`), so consumer code
-- reading a verified data point is identical to code reading a pushed one. There
-- is no `metadata` field, since metadata is an envelope annotation the
-- distributor does not sign and so cannot be authenticated; `VerifiedQuote`
-- drops it for the same reason. The trailing three are the evidence triple,
-- retained so the verification can be reproduced off-ledger.
data VerifiedDataPoint = VerifiedDataPoint with
    distributor : Party
      -- ^ The distributor whose key validated the signature, taken from the
      -- `DistributorKey` view (or from the caller's pinned argument on the
      -- `...With` overload). It is never read out of the payload, so a payload
      -- cannot claim a distributor it was not signed by.
    publishedAt : Time
      -- ^ Copied from the verified payload: when the distributor produced the
      -- data point.
    schemaVersion : Text
      -- ^ Copied from the verified payload: the version of the authenticated
      -- payload's schema.
    values : Values
      -- ^ Copied from the verified payload: the authenticated key/value payload.
    canonicalHash : Text
      -- ^ The structural root hash of the signed payload, hex-encoded. This is
      -- the digest the signature commits to; retained as evidence for off-ledger
      -- re-verification, and the durable join key for anything that must
      -- reference this verification.
    signature : Text
      -- ^ The verified signature, hex-encoded DER ECDSA. Retained as evidence.
    publicKey : Text
      -- ^ The public key the signature verified against. Retained as evidence so
      -- re-verification needs nothing else.
  deriving (Eq, Show)

-- | Extensibility metadata, present on every Data Standard view.
--
-- Metadata is the channel for additive evolution: a producer attaches new
-- annotations as entries here instead of changing a view's shape, so a consumer
-- that does not recognise a key ignores it and is never broken by the
-- addition. Keys SHOULD be prefixed with the DNS name of the application that
-- defines them (for example, "exampleoracle.com/source"), following the
-- convention the Canton token standard uses for its own metadata. Entries
-- SHOULD be kept small, because on-ledger data is costly.
data Metadata = Metadata with
    values : TextMap Text
  deriving (Eq, Show)

-- | Metadata carrying no annotations; the conventional contents of a view's
-- `metadata` field when the distributor has nothing to attach.
emptyMetadata : Metadata
emptyMetadata = Metadata with values = TM.empty

-- | Turn a list of `Optional` into an `Optional` list, yielding `None` if any element is `None`.
sequenceOptional : [Optional a] -> Optional [a]
sequenceOptional = foldr go (Some [])
  where
    go ox oacc = case (ox, oacc) of
      (Some x, Some acc) -> Some (x :: acc)
      _                  -> None

-- | Apply an `Optional`-returning function to every value of a `TextMap`, yielding `None` if any application is `None`.
traverseTextMap : (a -> Optional b) -> TextMap a -> Optional (TextMap b)
traverseTextMap f m =
  let pairs = TM.toList m
  in case sequenceOptional [ mapPair k <$> f v | (k, v) <- pairs ] of
       Some kvs -> Some (TM.fromList kvs)
       None     -> None
  where
    mapPair : Text -> b -> (Text, b)
    mapPair k b = (k, b)

-- | Insert a field into a payload, tagging the native value through its
-- `ToAnyValue` instance.
insertField : ToAnyValue v => Text -> v -> Values -> Values
insertField key v = TM.insert key (toAny v)

-- | Read a field from a payload at its expected type. Returns `None` when the
-- field is absent or holds a different type.
lookupField : FromAnyValue v => Text -> Values -> Optional v
lookupField key row = fromAny =<< TM.lookup key row
