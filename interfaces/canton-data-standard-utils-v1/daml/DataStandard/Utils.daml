-- | Shared value types for the Data Standard's payloads. Every interface
-- package depends on this one, as do the applications implementing or consuming
-- those interfaces. It is data-only, so it can be smart-contract-upgraded.
module DataStandard.Utils where

import DA.TextMap (TextMap)
import qualified DA.TextMap as TM

-- REIVEW(SM): the comment from https://github.com/kaikodata/canton-data-standard/pull/11/changes#r3860088698 still stands.

-- | The closed, recursive set of values a `Values` payload may hold: the
-- scalars plus an ordered list and a string-keyed map, so a structured payload
-- such as an index's constituents is expressible. The standard decides which
-- constructors exist; a distributor cannot add one. Closing the set gives every
-- value a single canonical hash, which is what the pull path relies on when it
-- reconstructs a payload on-ledger to check a signature.
data AnyValue
  = AVInt Int
  | AVDecimal Decimal
  | AVText Text
  | AVTime Time
  | AVBool Bool
  | AVList [AnyValue]
  | AVMap (TextMap AnyValue)
  deriving (Eq, Show)

-- | A data point's payload: a map from field name to tagged value. Which fields
-- a feed carries, and at which types, is what the `schemaVersion` on the view
-- exposing the payload identifies.
type Values = TextMap AnyValue

-- | Conversion of a native Daml value into its `AnyValue` tag, so `insertField`
-- takes a native value without the caller naming a constructor.
class ToAnyValue a where
  toAny : a -> AnyValue

-- | Recovery of a native Daml value from its `AnyValue` tag. `None` when the
-- tag holds a different type, so asking for the wrong type never silently
-- coerces.
class FromAnyValue a where
  fromAny : AnyValue -> Optional a

instance ToAnyValue Int where toAny = AVInt
instance FromAnyValue Int where
  fromAny (AVInt i) = Some i
  fromAny _         = None

instance ToAnyValue Decimal where toAny = AVDecimal
instance FromAnyValue Decimal where
  fromAny (AVDecimal d) = Some d
  fromAny _             = None

instance ToAnyValue Text where toAny = AVText
instance FromAnyValue Text where
  fromAny (AVText t) = Some t
  fromAny _          = None

instance ToAnyValue Time where toAny = AVTime
instance FromAnyValue Time where
  fromAny (AVTime t) = Some t
  fromAny _          = None

instance ToAnyValue Bool where toAny = AVBool
instance FromAnyValue Bool where
  fromAny (AVBool b) = Some b
  fromAny _          = None

instance ToAnyValue AnyValue where toAny = identity
instance FromAnyValue AnyValue where fromAny = Some

instance ToAnyValue a => ToAnyValue [a] where
  toAny xs = AVList (map toAny xs)
instance FromAnyValue a => FromAnyValue [a] where
  fromAny (AVList xs) = sequenceOptional (map fromAny xs)
  fromAny _           = None

instance ToAnyValue a => ToAnyValue (TextMap a) where
  toAny m =
    let kvs  = TM.toList m
        kvs' = map (\(k, v) -> (k, toAny v)) kvs
    in AVMap (TM.fromList kvs')
instance FromAnyValue a => FromAnyValue (TextMap a) where
  fromAny (AVMap m) = traverseTextMap fromAny m
  fromAny _         = None

-- | A single price for a named feed, observed at a market instant: the economic
-- content of a quote and no more. Provenance belongs to the view that wraps a
-- `Quote`, so the same value can be reused across views.
data Quote = Quote with
    feedId : Text
      -- ^ The price feed, for example "BTC/USD".
    price : Decimal
      -- ^ The quoted price, as an exact base-10 fixed-point number.
    priceTime : Time
      -- ^ The "as of" instant: the market time the price is observed for. Set it
      -- equal to the view's `publishedAt` for a feed with no distinct
      -- observation time.
  deriving (Eq, Show)

-- | The record a consumer reconstructs and hands to `verifyQuote`: exactly the
-- fields the distributor signed off-ledger. The signature travels beside it,
-- since it is taken over the hash of these fields and so cannot cover itself.
--
-- It lives in this data-only package rather than in the codec library so that
-- every distributor and consumer names one shape for a signed quote, and so a
-- template may store it: a utility package's types are not serializable.
data SignedQuote = SignedQuote with
    publishedAt : Time
      -- ^ When the distributor produced and signed the quote. Same meaning as
      -- `PublishedQuoteView.publishedAt`.
    expiresAt : Time
      -- ^ The instant after which the payload is refused; the boundary instant
      -- itself is still accepted. This is the standard's only replay defence: a
      -- captured (payload, signature) pair stops verifying once it lapses. Must
      -- be at or after `publishedAt`.
    quote : Quote
      -- ^ The economic content, as in `PublishedQuoteView.quote`.
  deriving (Eq, Show)

-- | The record a consumer reconstructs and hands to `verifyDataPoint`: exactly
-- the fields the distributor signed off-ledger, with the signature beside it,
-- as on `SignedQuote`.
data SignedDataPoint = SignedDataPoint with
    publishedAt : Time
      -- ^ When the distributor produced and signed the data point. Same meaning
      -- as `PublishedDataPointView.publishedAt`.
    expiresAt : Time
      -- ^ The instant after which the payload is refused; the boundary instant
      -- itself is still accepted. This is the standard's only replay defence: a
      -- captured (payload, signature) pair stops verifying once it lapses. Must
      -- be at or after `publishedAt`.
    schemaVersion : Text
      -- ^ Semantic version of the `values` schema, as in
      -- `PublishedDataPointView.schemaVersion`. Signed, so a replayer cannot
      -- re-present authentic values under a different schema.
    values : Values
      -- ^ The payload, as in `PublishedDataPointView.values`. The structural
      -- hash walks it in key-sorted order, so the same payload always hashes
      -- alike.
  deriving (Eq, Show)

-- | What `verifyQuote` returns on success. It has no contract id: a consumer
-- uses the result in the same transaction and records whatever its own
-- templates need. The leading fields mirror `PublishedQuoteView`, so code
-- reading a verified quote matches code reading a pushed one; the trailing
-- three are the evidence needed to reproduce the check off-ledger.
data VerifiedQuote = VerifiedQuote with
    distributor : Party
      -- ^ The distributor whose key validated the signature, taken from the key
      -- and never from the payload.
    publishedAt : Time
      -- ^ From the verified payload.
    quote : Quote
      -- ^ The authenticated economic content.
    canonicalHash : Text
      -- ^ The structural root hash the signature committed to, hex-encoded.
      -- Also the durable join key for anything referencing this verification.
    signature : Text
      -- ^ The verified signature, hex-encoded DER ECDSA.
    publicKey : Text
      -- ^ The key the signature verified against.
  deriving (Eq, Show)

-- | What `verifyDataPoint` returns on success, mirroring
-- `PublishedDataPointView` in the same way `VerifiedQuote` mirrors the quote
-- view. There is no `metadata` field: metadata is an envelope annotation the
-- distributor does not sign, and so cannot be authenticated.
data VerifiedDataPoint = VerifiedDataPoint with
    distributor : Party
      -- ^ The distributor whose key validated the signature, taken from the key
      -- and never from the payload.
    publishedAt : Time
      -- ^ From the verified payload.
    schemaVersion : Text
      -- ^ From the verified payload.
    values : Values
      -- ^ The authenticated key/value payload.
    canonicalHash : Text
      -- ^ The structural root hash the signature committed to, hex-encoded.
      -- Also the durable join key for anything referencing this verification.
    signature : Text
      -- ^ The verified signature, hex-encoded DER ECDSA.
    publicKey : Text
      -- ^ The key the signature verified against.
  deriving (Eq, Show)

-- | Extensibility metadata, present on every view. It is the channel for
-- additive evolution: a distributor attaches new annotations as entries here
-- instead of changing a view's shape, and a consumer ignores keys it does not
-- recognise. Keys SHOULD be prefixed with the DNS name of the application
-- defining them ("exampleoracle.com/source"), and entries SHOULD be kept small,
-- because on-ledger data is costly.
data Metadata = Metadata with
    values : TextMap Text
  deriving (Eq, Show)


-- | Metadata carrying no annotations.
emptyMetadata : Metadata
emptyMetadata = Metadata with values = TM.empty


-- REVIEW(SM): this is referenced from interface definitions, which can't be upgraded. Move code out of this package.
-- Also consider either dropping it by defining the datatypes in a base interface package and importing that
-- (as done in token standard with the metadata types and the allocation type [defined in allocation and used in allocation-instruction and allocation-request)
-- or alternatively make this a `canton-data-standard-types-v1` package and have the interface packages depend on it.

-- | Turn a list of `Optional` into an `Optional` list, yielding `None` if any element is `None`.
sequenceOptional : [Optional a] -> Optional [a]
sequenceOptional = foldr go (Some [])
  where
    go ox oacc = case (ox, oacc) of
      (Some x, Some acc) -> Some (x :: acc)
      _                  -> None

-- | Apply an `Optional`-returning function to every value of a `TextMap`, yielding `None` if any application is `None`.
traverseTextMap : (a -> Optional b) -> TextMap a -> Optional (TextMap b)
traverseTextMap f m =
  let pairs = TM.toList m
  in case sequenceOptional [ mapPair k <$> f v | (k, v) <- pairs ] of
       Some kvs -> Some (TM.fromList kvs)
       None     -> None
  where
    mapPair : Text -> b -> (Text, b)
    mapPair k b = (k, b)

-- | Insert a field into a payload, tagging the native value through its
-- `ToAnyValue` instance.
insertField : ToAnyValue v => Text -> v -> Values -> Values
insertField key v = TM.insert key (toAny v)

-- | Read a field from a payload at its expected type. `None` when the field is
-- absent or holds a different type.
lookupField : FromAnyValue v => Text -> Values -> Optional v
lookupField key row = fromAny =<< TM.lookup key row
