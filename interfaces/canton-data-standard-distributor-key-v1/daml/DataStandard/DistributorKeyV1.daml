-- | The signing-key publication interface. A distributor that delivers data by
-- signature rather than by contract implements `DistributorKey` on its own
-- template, so consumers can learn the key to check its signatures against.
--
-- This package holds a view and one read choice, and no more. Verification is
-- library code in `canton-data-standard-codecs`, run inside the consumer's own
-- choice: a package defining an interface can never be smart-contract-upgraded,
-- so code placed here would be unfixable.
module DataStandard.DistributorKeyV1 where

-- | The view every `DistributorKey` implementation exposes: the party whose
-- signatures the key validates, the key, and the three identifiers that select
-- the matching off-ledger recipe.
--
-- The key is resident on a contract the distributor signs, which is what makes
-- it trustworthy: verification uses this key and not one the caller supplied.
data DistributorKeyView = DistributorKeyView with
    distributor : Party
      -- ^ The party whose signatures this key validates. Verification copies it
      -- into its result, so a verified payload names an authenticated
      -- distributor and not one the payload itself claimed.
    publicKey : Text
      -- ^ The distributor's secp256k1 public key, hex-encoded DER (SPKI). One
      -- key authenticates every feed the distributor signs.
    signMethod : Text
      -- ^ The signature scheme. `"secp256k1"` for every implementation the
      -- standard currently defines.
    hashMethod : Text
      -- ^ The hash function the scheme is applied over. `"SHA-256"` for every
      -- implementation the standard currently defines.
    payloadCodec : Text
      -- ^ The identifier of the encoding this key signs, for example
      -- `"v2-quote-hash"`. It selects the off-ledger encoder the signer must
      -- use and the library function a consumer verifies with; verification
      -- rejects a key whose codec id it does not implement. Products advertise
      -- their own ids on this field.
  deriving (Eq, Show)

-- REVIEW(SM): why do we need the key to be explicit? Can't we keep the verification
-- method internal to the implementation of the interface of a `DatapointProvider`?
--
-- For interfaces less is more. From a consumption perspective, we'd ideally have
-- a single interface for the on-ledger and the off-ledger distribution path, with a single read choice.
--
-- I believe we can achieve this along the following lines:


interface DatapointProvider where
  viewtype DatapointProviderView

  nonconsuming choice DatapointProvider_Decode : DatapointView
    with
      encodedDatapoint : EncodedDatapoint
      actor : Party
    controller actor
    do pure (view this)

data EncodedDatapoint = EncodedDatapoint with
    encodedValues : TextMap AnyValue
      -- ^ Distributor chosen encoding.
  deriving (Eq, Show)

data DatapointView = DatapointView with
    distributor : Party
      -- ^ The party that published the data, and whom the consumer chooses to
      -- trust as its source.
    publishedAt : Time
      -- ^ When the distributor produced the data, which is not necessarily when
      -- the contract was created.
    schemaVersion : Text
      -- ^ Semantic version of the `values` schema. It describes a given feed's
      -- payload and evolves per distributor, independently of the interface
      -- version in this package's name.
    values : Values
      -- ^ The payload, as a map of field names to tagged values.
    metadata : Metadata
      -- ^ Additive annotations that are not part of the data itself.
  deriving (Eq, Show)

-- | Uniform type to represent a datapoint on-ledger that works with both the on-ledger and off-ledger distribution path.
--
-- On-ledger published datapoints use `EncodedDatapoint TextMap.empty`
type Datapoint = (ContractId DatapointProvider, EncodedDatapoint)



-- | The signing-key publication interface. Key rotation is instance
-- replacement, through a choice on the distributor's own template: rotation
-- policy belongs to the distributor, so the interface defines none.
interface DistributorKey where
  viewtype DistributorKeyView

  -- | Read the view from a contract the caller can see. A party holding the
  -- contract by explicit disclosure is not a stakeholder and so cannot `fetch`
  -- it; this choice is authorised by the caller alone, and returns the view
  -- rather than the implementing template.
  nonconsuming choice DistributorKey_Fetch : DistributorKeyView
    with
      actor : Party
        -- ^ The party reading the key, and the sole controller of the choice.
    controller actor
    do pure (view this)
