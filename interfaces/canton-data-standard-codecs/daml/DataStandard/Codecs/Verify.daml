-- | Signature verification for the standard's signed payloads: the checks a
-- consumer runs, inside its own choice, on a payload a distributor signed
-- off-ledger. Every validating participant re-executes them, exactly as it
-- would an interface choice, and because this is library code in an upgradable
-- utility package a defect in it is fixable.
--
-- This is the only module touching the alpha `DA.Crypto.Text` builtins, which is
-- why the package is built with `-Wno-crypto-text-is-alpha`. Code that merely
-- calls these functions needs no flag of its own.
--
-- Each function returns `Either Text` rather than aborting, so a caller decides
-- whether a failed verification aborts its transaction or takes another branch.
-- The `Left` messages are ordered and exact, and are part of this package's
-- public surface.
module DataStandard.Codecs.Verify
  ( verifyQuote
  , verifyQuoteWith
  , verifyDataPoint
  , verifyDataPointWith
  ) where

import DA.Crypto.Text (secp256k1)

import DataStandard.Codecs.Envelope
  ( dataPointHashCodecId, hashSignedDataPoint, hashSignedQuote, quoteHashCodecId )
import DataStandard.Codecs.StructuralHash (Hash)
import DataStandard.DistributorKeyV1 (DistributorKeyView)
import DataStandard.Utils
  ( SignedDataPoint, SignedQuote, VerifiedDataPoint(..), VerifiedQuote(..) )

-- | Verify a signed quote against a distributor's published key. The key's
-- `payloadCodec` must name the quote envelope this package implements, so a key
-- published for another codec is refused rather than checked against the wrong
-- hash. The verified `distributor` comes from the key's view and never from the
-- payload.
--
-- Failures, in the order they are checked: `"unsupported payload codec"`,
-- `"published after expiry"`, `"payload expired"`, `"invalid signature"`.
verifyQuote : DistributorKeyView -> Time -> SignedQuote -> Text -> Either Text VerifiedQuote
verifyQuote key now payload signature = do
  requireCodec quoteHashCodecId key
  verifyQuoteWith key.distributor key.publicKey now payload signature

-- | Verify a signed quote against a distributor and key the caller pins itself,
-- for a caller holding the key by some means other than a `DistributorKey`
-- contract. Prefer `verifyQuote` when reading a published key: it also checks
-- the key was published for this envelope.
--
-- Failures, in the order they are checked: `"published after expiry"` (a window
-- ending before it begins is never live), `"payload expired"` (`now` strictly
-- after `expiresAt`; the boundary instant is accepted), `"invalid signature"`.
verifyQuoteWith : Party -> Text -> Time -> SignedQuote -> Text -> Either Text VerifiedQuote
verifyQuoteWith distributor publicKey now payload signature = do
  let rootHash = hashSignedQuote payload
  requireWindow payload.publishedAt payload.expiresAt now
  requireSignature rootHash publicKey signature
  Right VerifiedQuote with
    distributor
    publishedAt = payload.publishedAt
    quote = payload.quote
    canonicalHash = rootHash.value
    signature
    publicKey

-- | Verify a signed data point against a distributor's published key. The key's
-- `payloadCodec` must name the data point envelope this package implements.
--
-- Failures, in the order they are checked: `"unsupported payload codec"`,
-- `"published after expiry"`, `"payload expired"`, `"invalid signature"`.
verifyDataPoint : DistributorKeyView -> Time -> SignedDataPoint -> Text -> Either Text VerifiedDataPoint
verifyDataPoint key now payload signature = do
  requireCodec dataPointHashCodecId key
  verifyDataPointWith key.distributor key.publicKey now payload signature

-- | Verify a signed data point against a distributor and key the caller pins
-- itself: the counterpart of `verifyQuoteWith`, with the same checks in the
-- same order.
verifyDataPointWith : Party -> Text -> Time -> SignedDataPoint -> Text -> Either Text VerifiedDataPoint
verifyDataPointWith distributor publicKey now payload signature = do
  let rootHash = hashSignedDataPoint payload
  requireWindow payload.publishedAt payload.expiresAt now
  requireSignature rootHash publicKey signature
  Right VerifiedDataPoint with
    distributor
    publishedAt = payload.publishedAt
    schemaVersion = payload.schemaVersion
    values = payload.values
    canonicalHash = rootHash.value
    signature
    publicKey

-- | The key was published for the envelope this verification implements.
requireCodec : Text -> DistributorKeyView -> Either Text ()
requireCodec codecId key =
  if key.payloadCodec == codecId then Right () else Left "unsupported payload codec"

-- | The signed validity window is well formed and still open at `now`.
requireWindow : Time -> Time -> Time -> Either Text ()
requireWindow publishedAt expiresAt now
  | publishedAt > expiresAt = Left "published after expiry"
  | now > expiresAt = Left "payload expired"
  | otherwise = Right ()

-- | The signature is valid over the payload's root hash under the distributor's
-- key. The root hash hex is the builtin's message argument: the builtin decodes
-- it and SHA-256s the resulting bytes, so an off-ledger signer signs ECDSA over
-- the SHA-256 of the root hash's bytes.
requireSignature : Hash -> Text -> Text -> Either Text ()
requireSignature rootHash publicKey signature =
  if secp256k1 signature rootHash.value publicKey
    then Right ()
    else Left "invalid signature"
