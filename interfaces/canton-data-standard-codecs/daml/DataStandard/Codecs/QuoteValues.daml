-- | The codec between the typed `Quote` and the generic `Values` payload, in
-- both directions, for consumers and distributors that want the generic form.
-- It is no part of the signing path: the quote envelope hashes a `Quote` as a
-- typed record and never passes through `Values`.
module DataStandard.Codecs.QuoteValues
  ( quoteToValues
  , valuesToQuote
  , feedIdField
  , priceField
  , priceTimeField
  ) where

import qualified DA.TextMap as TM

import DataStandard.Utils (AnyValue(..), Quote(..), Values)

-- | The `Values` field name carrying a quote's `feedId`.
feedIdField : Text
feedIdField = "feedId"

-- | The `Values` field name carrying a quote's `price`.
priceField : Text
priceField = "price"

-- | The `Values` field name carrying a quote's `priceTime`.
priceTimeField : Text
priceTimeField = "priceTime"

-- | Render a quote as a generic payload. Total, and the inverse of
-- `valuesToQuote` on every quote.
quoteToValues : Quote -> Values
quoteToValues q = TM.fromList
  [ (feedIdField, AVText q.feedId)
  , (priceField, AVDecimal q.price)
  , (priceTimeField, AVTime q.priceTime)
  ]

-- | Read a quote back out of a generic payload, or explain why the payload is
-- not one. Strict on purpose: exactly the three quote fields, each under its
-- expected tag, and nothing else, so that two different payloads cannot decode
-- to the same quote. The message names the field at fault.
valuesToQuote : Values -> Either Text Quote
valuesToQuote values = do
  feedId <- requireText feedIdField
  price <- requireDecimal priceField
  priceTime <- requireTime priceTimeField
  case [ k | (k, _) <- TM.toList values, k /= feedIdField, k /= priceField, k /= priceTimeField ] of
    (extra :: _) -> Left ("unexpected field: " <> extra)
    [] -> Right (Quote with feedId, price, priceTime)
  where
    require : Text -> Either Text AnyValue
    require key = case TM.lookup key values of
      None -> Left ("missing field: " <> key)
      Some v -> Right v

    wrongType : Text -> Either Text a
    wrongType key = Left ("wrong type for field: " <> key)

    requireText key = do
      v <- require key
      case v of
        AVText t -> Right t
        _ -> wrongType key

    requireDecimal key = do
      v <- require key
      case v of
        AVDecimal d -> Right d
        _ -> wrongType key

    requireTime key = do
      v <- require key
      case v of
        AVTime t -> Right t
        _ -> wrongType key
