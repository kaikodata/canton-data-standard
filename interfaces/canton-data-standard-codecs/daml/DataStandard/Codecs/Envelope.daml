-- | The signed envelope: what a distributor's signature commits to, and the
-- codec id naming that envelope on a `DistributorKeyView`.
--
-- There is one envelope, because there is one payload shape. A price quote is a
-- data point carrying three fields (`DataStandard.Codecs.Quote`), so it is
-- signed, hashed and verified exactly as any other payload is, and an
-- off-ledger signer has a single encoding to implement.
--
-- The envelope is hashed as a record of its fields, so the field order below is
-- normative: an off-ledger signer hashes the same fields in the same order. It
-- commits to the validity window (`publishedAt`, `expiresAt`), which is what
-- makes `expiresAt` a signed replay bound rather than a hint a replayer could
-- edit, and to `schemaVersion`, since a payload's meaning depends on it.
module DataStandard.Codecs.Envelope
  ( dataPointHashCodecId
  , hashSignedDataPoint
  ) where

import DataStandard.Codecs.StructuralHash (Hash, Hashable(hash), hashRecord)
import DataStandard.Utils (AnyValue(..), SignedDataPoint)

-- | The data point envelope's id, as advertised on a
-- `DistributorKeyView.payloadCodec`. A key naming it signs payloads hashed by
-- `hashSignedDataPoint`, quotes included.
dataPointHashCodecId : Text
dataPointHashCodecId = "v2-datapoint-hash"

-- | The hash a signature commits to: a 4-field record of the validity window,
-- the schema version and the payload. The payload goes through the tagged
-- `AnyValue` path as a map node, so its field names, value types and nesting
-- are all part of the hash.
hashSignedDataPoint : SignedDataPoint -> Hash
hashSignedDataPoint p = hashRecord
  [ hash p.publishedAt
  , hash p.expiresAt
  , hash p.schemaVersion
  , hash (AVMap p.values)
  ]
