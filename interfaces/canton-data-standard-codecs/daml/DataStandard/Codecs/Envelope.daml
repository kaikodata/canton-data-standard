-- | The signed envelopes: what a distributor's signature commits to for each of
-- the standard's two payload shapes, and the codec ids naming those envelopes
-- on a `DistributorKeyView`.
--
-- An envelope is hashed as a record of its fields, so the field order below is
-- normative: an off-ledger signer hashes the same fields in the same order.
-- Both envelopes commit to the validity window (`publishedAt`, `expiresAt`),
-- which is what makes `expiresAt` a signed replay bound rather than a hint a
-- replayer could edit. The quote envelope has no schema string, since a quote's
-- shape is fixed by this standard; the data point envelope commits to
-- `schemaVersion`, since a generic payload's meaning depends on it.
module DataStandard.Codecs.Envelope
  ( quoteHashCodecId
  , dataPointHashCodecId
  , hashQuote
  , hashSignedQuote
  , hashSignedDataPoint
  ) where

import DataStandard.Codecs.StructuralHash (Hash, Hashable(hash), hashRecord)
import DataStandard.Utils (AnyValue(..), Quote, SignedDataPoint, SignedQuote)

-- | The quote envelope's id, as advertised on a
-- `DistributorKeyView.payloadCodec`. A key naming it signs quotes hashed by
-- `hashSignedQuote`.
quoteHashCodecId : Text
quoteHashCodecId = "v2-quote-hash"

-- | The data point envelope's id, as advertised on a
-- `DistributorKeyView.payloadCodec`. A key naming it signs data points hashed
-- by `hashSignedDataPoint`.
dataPointHashCodecId : Text
dataPointHashCodecId = "v2-datapoint-hash"

-- | The hash of a quote's economic content: a 3-field record of the feed, the
-- price and the market instant. `hashSignedQuote` nests it rather than
-- flattening it, so a quote hashes identically wherever it is embedded.
hashQuote : Quote -> Hash
hashQuote q = hashRecord [hash q.feedId, hash q.price, hash q.priceTime]

-- | The hash a quote signature commits to: a 3-field record of the validity
-- window and the nested quote.
hashSignedQuote : SignedQuote -> Hash
hashSignedQuote sq = hashRecord [hash sq.publishedAt, hash sq.expiresAt, hashQuote sq.quote]

-- | The hash a data point signature commits to: a 4-field record of the
-- validity window, the schema version and the payload. The payload goes through
-- the tagged `AnyValue` path as a map node, so its field names, value types and
-- nesting are all part of the hash.
hashSignedDataPoint : SignedDataPoint -> Hash
hashSignedDataPoint p = hashRecord
  [ hash p.publishedAt
  , hash p.expiresAt
  , hash p.schemaVersion
  , hash (AVMap p.values)
  ]
