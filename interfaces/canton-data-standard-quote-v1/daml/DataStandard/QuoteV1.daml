-- | The price quote interface. A distributor implements `PublishedQuote` on its
-- own template to publish a single typed price for a named feed; a consumer
-- reads it through the interface, without depending on the distributor's
-- package.
module DataStandard.QuoteV1 where

import DataStandard.Utils (Metadata, Quote)

-- | The view every `PublishedQuote` implementation exposes: a `Quote` plus the
-- provenance the quote itself omits.
data PublishedQuoteView = PublishedQuoteView with
    distributor : Party
      -- ^ The party that published the quote, and whom the consumer chooses to
      -- trust as its source. A consumer trusts a (distributor, feedId) pair;
      -- switching distributor is re-pointing it, with no recompile.
    quote : Quote
      -- ^ The economic content: the feed, its price, and the market instant the
      -- price is observed for.
    publishedAt : Time
      -- ^ When the distributor produced the quote. Distinct from
      -- `quote.priceTime`, since a quote can be produced after the instant it
      -- prices, and from the contract-creation time. Consumers use it for
      -- staleness checks.
    metadata : Metadata
      -- ^ Additive annotations that are not part of the quote itself.
  deriving (Eq, Show)

-- | The price quote interface. It is independent of
-- `DataStandard.DataPointV1`: a distributor whose publications should be
-- readable both ways implements both interfaces on one template, setting
-- `distributor` and `publishedAt` identically across the two views.
interface PublishedQuote where
  viewtype PublishedQuoteView

  -- | Read the view from a contract the caller can see. A party holding the
  -- contract by explicit disclosure is not a stakeholder and so cannot `fetch`
  -- it; this choice is authorised by the caller alone, and returns the view
  -- rather than the implementing template.
  nonconsuming choice PublishedQuote_Fetch : PublishedQuoteView
    with
      actor : Party
        -- ^ The party reading the quote, and the sole controller of the choice.
    controller actor
    do pure (view this)
